{
  "name": "@gather/desktop",
  "private": true,
  "version": "1.2.0",
  "description": "Gather desktop novel studio.",
  "author": "SukrutN",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "build": "npm run typecheck && electron-vite build",
    "start": "npm run build && electron-vite preview --skipBuild",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "dist": "node scripts/prepare-win-codesign-cache.mjs && npm run build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@fontsource/literata": "^5.3.0",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.4"
  }
}
