{
  "name": "@gather/desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Gather desktop novel studio.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "start": "npm run build && electron-vite preview --skipBuild"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@fontsource/literata": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^35.7.5",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
