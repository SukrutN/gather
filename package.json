{
  "name": "gather",
  "private": true,
  "version": "1.2.0",
  "description": "Gather is a local-first novel studio.",
  "workspaces": [
    "apps/desktop",
    "apps/web"
  ],
  "scripts": {
    "dev:desktop": "npm run dev -w @gather/desktop",
    "start:desktop": "npm run start -w @gather/desktop",
    "build:desktop": "npm run build -w @gather/desktop",
    "dev:web": "npm run dev -w @gather/web",
    "build:web": "npm run build -w @gather/web",
    "preview:web": "npm run preview -w @gather/web",
    "build": "npm run build:desktop && npm run build:web",
    "typecheck": "npm run typecheck -w @gather/desktop && npm run typecheck -w @gather/web",
    "test": "npm run test -w @gather/desktop",
    "test:e2e": "npm run test:e2e -w @gather/desktop",
    "dist": "npm run dist -w @gather/desktop"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
